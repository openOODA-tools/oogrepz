// # oogrepz Main Entry Point
//
// Logline: Zero-copy streaming search across gzip, bzip2, xz, and zstd compressed archives.
//
// Setup: Demands explicit capability tokens and standard argument list.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, --test, --demo, or --mcp.
//   2. Identify compression format signatures for target files.
//   3. Search uncompressed stream lines with case and match controls.
//   4. Format and stream rendered terminal highlights or structured JSON telemetry.

import "core/archive_types.oo";
import "core/format_detector.oo";
import "core/stream_reader.oo";
import "core/pattern_matcher.oo";
import "render/render_matches.oo";
import "render/render_json.oo";
import "render/render_demo.oo";
import "ipc/cli_options.oo";
import "ipc/mcp_server.oo";
import "anchor.oo";

fn run_all_tests() -> Bool {
    if !verify_root_subsystem() {
        return false;
    }

    let t1_args: List[String] = list_push(list_push(list_new(), "-i"), "test");
    let opts: CliOptions = parse_cli_options(t1_args);
    if !opts.search_opts.ignore_case || opts.search_opts.pattern != "test" {
        return false;
    }

    let fmt_gz: ArchiveFormat = detect_format_from_path("log.tar.gz");
    let fmt_bz: ArchiveFormat = detect_format_from_path("data.bz2");
    let fmt_xz: ArchiveFormat = detect_format_from_path("archive.xz");
    let fmt_zs: ArchiveFormat = detect_format_from_path("stream.zst");
    if fmt_gz.name != "gzip" || fmt_bz.name != "bzip2" || fmt_xz.name != "xz" || fmt_zs.name != "zstd" {
        return false;
    }

    let mut lines: List[String] = list_new();
    lines = list_push(lines, "Root Capability Boundary");
    lines = list_push(lines, "Ambient Authority: ZERO");
    lines = list_push(lines, "Terminal Streaming Active");

    let mut s_opts: SearchOptions = default_search_options("zero");
    s_opts.ignore_case = true;
    s_opts.line_number = true;

    let res: FileSearchResult = search_stream_lines("test.log.gz", "gzip", lines, s_opts);
    if res.match_count != 1 {
        return false;
    }

    let first_m: MatchLine = list_get(res.matches, 0);
    if first_m.line_num != 2 {
        return false;
    }

    return true;
}

pub fn main(
    fr: &FsReadCap,
    _pr: &ProcessCap,
    _env: &EnvCap,
    args: List[String]
) -> Int {
    let opts: CliOptions = parse_cli_options(args);

    if opts.show_help {
        print(render_cli_help());
        return 0;
    }
    if opts.show_version {
        print(render_cli_version());
        return 0;
    }
    if opts.run_test {
        if run_all_tests() {
            print("oogrepz: internal anchor tests PASSED\n");
            return 0;
        } else {
            print("oogrepz: internal anchor tests FAILED\n");
            return 1;
        }
    }
    if opts.show_mcp {
        return run_mcp_server(fr);
    }
    if opts.show_demo {
        print(render_grepz_demo(opts.search_opts.use_color));
        return 0;
    }

    if chars_len(opts.search_opts.pattern) == 0 {
        print("oogrepz: missing pattern argument (try --help)\n");
        return 2;
    }

    let n_files: Int = list_len(opts.files);
    let mut all_results: List[FileSearchResult] = list_new();
    let mut total_matches: Int = 0;

    if n_files == 0 {
        // Fallback simulated input for showcase/testing when no files are passed
        let mut sim_lines: List[String] = list_new();
        sim_lines = list_push(sim_lines, "oogrepz: sovereign compressed stream search engine");
        sim_lines = list_push(sim_lines, "openOODA capability-bounded archive inspection");

        let res: FileSearchResult = search_stream_lines("stdin", "stream", sim_lines, opts.search_opts);
        all_results = list_push(all_results, res);
        total_matches = total_matches + res.match_count;
    } else {
        let mut fi: Int = 0;
        while fi < n_files {
            let file_path: String = list_get(opts.files, fi);
            let r: Result[String, String] = read_archive_stream(fr, file_path);

            if r.is_ok() {
                let content: String = match r { Ok(s) => s, Err(_) => "" };
                let fmt: ArchiveFormat = detect_format_from_path(file_path);
                let lines: List[String] = split_into_lines(content);
                let res: FileSearchResult = search_stream_lines(file_path, fmt.name, lines, opts.search_opts);
                all_results = list_push(all_results, res);
                total_matches = total_matches + res.match_count;
            } else {
                print("oogrepz: " + file_path + ": No such file or directory\n");
            }
            fi = fi + 1;
        }
    }

    if opts.json_output {
        print(multi_results_to_json(all_results, opts.search_opts.pattern) + "\n");
        return if total_matches > 0 { 0 } else { 1 };
    }

    print(render_multi_results(all_results, opts.search_opts));
    return if total_matches > 0 { 0 } else { 1 };
}
