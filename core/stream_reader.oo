// # Archive Stream Reader and Line Splitter
//
// Logline: Reads compressed or plain streams via capability tokens and partitions into lines.
//
// Setup: Requires &FsReadCap for reading target archive paths with negative-trust buffering.
//
// Beats:
//   1. Partition character buffers into distinct newline-terminated lines.
//   2. Read raw file content via explicit capability token.
//   3. Extract header bytes for format identification.
//   4. Deliver structured stream buffer to pattern matching engine.

pub fn split_into_lines(raw: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let n: Int = chars_len(raw);
    let mut start: Int = 0;
    let mut i: Int = 0;

    while i < n {
        let b: Int = byte_at(raw, i);
        if b == 10 { // '\n'
            let mut line: String = str_slice(raw, start, i);
            if chars_len(line) > 0 && byte_at(line, chars_len(line) - 1) == 13 {
                line = str_slice(line, 0, chars_len(line) - 1);
            }
            lines = list_push(lines, line);
            start = i + 1;
        }
        i = i + 1;
    }

    if start < n {
        let mut line: String = str_slice(raw, start, n);
        if chars_len(line) > 0 && byte_at(line, chars_len(line) - 1) == 13 {
            line = str_slice(line, 0, chars_len(line) - 1);
        }
        lines = list_push(lines, line);
    }

    return lines;
}

pub fn read_archive_stream(fs: &FsReadCap, path: String) -> Result[String, String] {
    return read_file(fs, path);
}
